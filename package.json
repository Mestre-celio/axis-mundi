{
  "name": "axis-mundi",
  "version": "1.0.0",
  "private": true,
  "description": "Portal Oracle das Religiões — Portal Axium",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "db:migrate": "cd database && psql \"$DATABASE_URL\" -f deploy.sql",
    "db:seed": "cd database && psql \"$DATABASE_URL\" -f seeds.sql",
    "lint": "cd backend && npm run typecheck && cd ../frontend && npm run typecheck",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
