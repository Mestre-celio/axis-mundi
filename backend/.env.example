# ============================================================
# AXIS MUNDI — BACKEND (Variáveis de Ambiente)
# ATENÇÃO: NUNCA comite este arquivo com valores reais.
# Copie para .env e preencha.
# ============================================================

# --- Supabase (Admin — NUNCA expor ao frontend) ---
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Asaas (Pagamentos) ---
# Ambiente: sandbox | production
ASAAS_ENV=sandbox
ASAAS_API_KEY=$aact_...
# Token secreto para validar webhooks recebidos
ASAAS_WEBHOOK_TOKEN=seu_token_aqui

# --- OpenAI (IA Generativa) ---
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

# --- Swiss Ephemeris ---
EPHE_PATH=./data/ephe

# --- JWT (Fallback para autenticação) ---
JWT_SECRET=uma-senha-forte-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=7d

# --- WhatsApp (Evolution API) ---
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=seu_key

# --- Storage ---
STORAGE_BUCKET=axis-mundi-docs

# --- Servidor ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
